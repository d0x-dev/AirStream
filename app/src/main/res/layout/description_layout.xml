<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:background="@drawable/rounded_ripple"
    android:padding="12dp">

    <!-- Title -->
    <TextView
        android:id="@+id/player_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"
        tools:text="Nachange Saari Raat (Slowed &amp; Reverb) | ARYAN" />

    <!-- Metadata Line -->
    <TextView
        android:id="@+id/player_views_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        tools:text="@aryan999 27 lakh views 1 yr ago #tulsikumar ...more" />

    <!-- HIDDEN ELEMENTS to avoid crashing ViewBinding -->
    <com.google.android.material.chip.Chip
        android:id="@+id/player_sponsor_badge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/player_description_arrow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.github.airstream.ui.views.DrawableTextView
        android:id="@+id/textLike"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.github.airstream.ui.views.DrawableTextView
        android:id="@+id/textDislike"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/meta_info"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tags_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/player_description"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/additional_video_info"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/player_title_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/desc_linLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>