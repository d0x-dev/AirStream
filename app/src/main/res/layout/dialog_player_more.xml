<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <TextView
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Download"
        android:textSize="16sp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_download" />

    <TextView
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Save"
        android:textSize="16sp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_bookmark_outlined" />

    <TextView
        android:id="@+id/btnAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Audio"
        android:textSize="16sp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_headphones" />

    <TextView
        android:id="@+id/btnPip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="PiP"
        android:textSize="16sp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_piped" />

    <TextView
        android:id="@+id/btnScreenshot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Screenshot"
        android:textSize="16sp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_fullscreen" />

</LinearLayout>